generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  // Null for OAuth-only users (Google / GitHub). Required for password users.
  password  String?
  // OAuth provider account IDs. Null for password-only users.
  googleId  String?  @unique
  githubId  String?  @unique
  plan      String   @default("free")  // free, pro, plus, business, enterprise
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  stripeCurrentPeriodEnd DateTime?
  // User settings as JSON
  settings   Json?
  // Data retention: days (null = forever), 90, 365
  retentionDays Int?
  // Active entity for multi-entity (Business+)
  activeEntityId String?
  // GDPR Art. 7 (consent) + Art. 8 (children) — when user accepted terms / confirmed age
  termsAcceptedAt   DateTime?
  ageConfirmedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  invoices         Invoice[]
  chatSessions     ChatSession[]
  approvalRules    ApprovalRule[]
  customRules      CustomRule[]
  auditLogs        AuditLog[]
  exportTemplates  ExportTemplate[]
  customStatuses   CustomStatus[]
  entities         Entity[]
  emailInboxes     EmailInbox[]
  emailBlocklist   EmailBlocklist[]
  pendingReviews   PendingReview[]
}

model Entity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // Optional: separate vendor mappings, rules, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model ExportTemplate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // Column definitions: [{key: 'vendor', label: 'Vendor Name', width: 30}, ...]
  columns   Json
  format    String   @default("csv")  // csv, json, excel
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model CustomStatus {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#6b7280")  // hex color
  // Order in workflow (0 = first)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model Invoice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityId    String?  // multi-entity (Business+)
  filename    String?
  vendor      String?
  invNumber   String?
  invDate     String?
  dueDate     String?
  amount      Float?
  vatAmount   Float?
  total       Float?
  currency    String   @default("USD")
  status      String   @default("pending")
  isDuplicate Boolean  @default(false)
  confidence  Float?
  fieldConfidence Json?
  rawExtraction Json?
  lineItems   Json?
  errorMessage String?
  // Validation engine results
  validationResults Json?
  validationStatus  String   @default("pending")  // pass, warning, fail
  // Normalized data
  normalizedVendor  String?
  normalizedInvDate String?
  normalizedDueDate String?
  normalizedAmount  Float?
  normalizedTotal   Float?
  normalizedCurrency String?
  // PDF metadata for tampering detection
  pdfMetadata  Json?
  // Processing metrics
  processingTime Float?
  // Custom fields extracted per user template
  customFields  Json?
  // Stored uploaded file for viewing (base64)
  fileData    String?
  fileType    String?
  // Auto-purge: fileData is deleted after this timestamp (saves DB storage)
  fileDataExpiresAt DateTime?
  // Approval workflow
  approvalStatus    String   @default("none")  // none, auto_approved, pending_review, blocked, approved, rejected
  approvalRuleId    String?
  approvedBy        String?
  approvedAt        DateTime?
  approvalNote      String?
  // Invoice lifecycle status (Pro+: pending/approved/exported; Plus+: custom statuses)
  lifecycleStatus   String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId])
  @@index([approvalStatus])
  @@index([vendor])
}

model ApprovalRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // Condition: amount threshold ranges
  minAmount Float?
  maxAmount Float?
  // Action: auto_approve, flag_for_review, block
  action    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

model CustomRule {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  conditionJson Json     // stores IF logic: {type: "and", conditions: [{field, operator, value}]}
  action        String   // flag_as_warning, flag_as_error, block
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceId String?
  action    String   // viewed, edited, approved, rejected, uploaded, deleted, exported, status_changed
  details   Json?    // {field, oldValue, newValue} or {note}
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([invoiceId])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  ChatMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  artifact  Json?
  createdAt DateTime @default(now())
  @@index([sessionId])
}

// ─── Email Capture ───────────────────────────────────────────────────────────
// Allows users to connect their IMAP inbox so invoices can be auto-imported.
// Credentials are AES-256-GCM encrypted using JWT_SECRET.

model EmailInbox {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // User-facing label e.g. "Work invoices", "Personal"
  label             String
  // The email address being scanned (for display + sender blocklist matching)
  emailAddress      String
  // IMAP connection details
  imapHost          String   // e.g. imap.gmail.com
  imapPort          Int      @default(993)
  // IMAP username (usually same as emailAddress but not always)
  username          String
  // AES-256-GCM encrypted password blob: "iv:ciphertext:authTag" (hex-encoded)
  encryptedPassword String
  // Resume point for chunked scanning — highest UID we've already processed
  lastSeenUID       Int      @default(0)
  // "manual" = every email goes to Pending Review (default, safest)
  // "trusted" = emails from trusted senders auto-import, others go to Pending
  scanMode          String   @default("manual")
  // List of trusted sender email addresses (lowercased) for "trusted" mode
  trustedSenders    Json?
  // Active = included in scan loop. Inactive = paused by user.
  active            Boolean  @default(true)
  lastScannedAt     DateTime?
  lastScanError     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  pendingReviews    PendingReview[]
  @@index([userId])
}

// ─── Pending Review Queue ────────────────────────────────────────────────────
// Emails that have been scanned but not yet approved. Never auto-imports to
// Invoices — user must explicitly approve each one. This is the safety net
// that prevents the user's invoice list from getting flooded with junk.

model PendingReview {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inboxId         String
  inbox           EmailInbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  // Email metadata (for display in the review queue)
  fromAddress     String
  fromName        String?
  subject         String
  receivedAt      DateTime
  // The attachment that was processed
  attachmentFilename String
  attachmentMime  String
  // Raw attachment bytes (base64) — kept only until user approves (then moved
  // to Invoice.fileData) or skips (then deleted)
  attachmentData  String
  // Quick classifier result
  // 'invoice' = looks like an invoice (high confidence)
  // 'maybe' = ambiguous — user should review
  // 'no' = probably not an invoice (but user can still approve)
  classification  String
  // If classified as 'invoice', the AI extraction result is cached here so the
  // approve action is instant (no re-extraction needed)
  extractedData   Json?
  // Status: 'pending' (waiting for user action), 'approved', 'skipped', 'blocked'
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([userId])
  @@index([inboxId])
  @@index([status])
}

// ─── Sender Blocklist ─────────────────────────────────────────────────────────
// Senders the user has explicitly blocked. Future emails from these addresses
// are auto-skipped at IMAP fetch time — no AI cost, no Pending entry.

model EmailBlocklist {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Lowercased email address to block (e.g. "newsletter@spam.com")
  address     String
  // Optional reason the user blocked (for their own reference)
  reason      String?
  createdAt   DateTime @default(now())
  @@index([userId])
  @@unique([userId, address])
}