# ─── Database ────────────────────────────────────────────────────────────
# Your Supabase Postgres connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://your-supabase-user:your-password@db.your-project.supabase.co:5432/postgres

# ─── Auth ───────────────────────────────────────────────────────────────
# JWT secret for signing user session tokens. Generate with:
#   openssl rand -hex 32
JWT_SECRET=your-random-32-hex-string-here

# ─── AI (Groq) — optional but recommended ────────────────────────────────
# Get from: https://console.groq.com/keys
# Groq is the secondary provider in both cascades (after Mistral).
# GROQ_API_KEY is now OPTIONAL — leaving it unset enables EU-only mode
# (Mistral only). When unset, the Groq cascade step is skipped.
GROQ_API_KEY=

# ─── AI Fallback (OpenRouter) — DISABLED BY DEFAULT ─────────────────────
# ⚠️ LEGAL COMPLIANCE: OpenRouter is DISABLED by default.
#
# OpenRouter's free-tier models (all model IDs ending in :free) route
# requests to underlying providers (Meta, Nvidia, Google, etc.) whose
# data-handling terms typically PERMIT TRAINING ON PROMPT CONTENT.
# There is no DPA or SCC in place with OpenRouter as of September 2026.
#
# To enable OpenRouter (NOT recommended for production EU personal data):
#   1. Complete a DPA with OpenRouter (https://openrouter.ai/legal)
#   2. Verify SCCs or confirm DPF certification
#   3. Switch to paid-tier models (remove :free suffix) to disable training
#   4. Update Privacy Policy §6 SCC Status table
#   5. Set ENABLE_OPENROUTER=true in Vercel env vars
#
# Free signup at https://openrouter.ai/keys (no credit card needed).
# Supports up to 5 keys for rotation.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=
# Set to 'true' to enable OpenRouter in the cascade. Default: disabled.
ENABLE_OPENROUTER=

# ─── AI Vision Fallback (Google Gemini direct API) ─────────────────────
# Optional but recommended — Google's Gemini API has its OWN free tier
# (separate from OpenRouter/Groq), so it multiplies your vision capacity.
# Free signup at https://aistudio.google.com/app/apikey (no credit card needed).
# 15 req/min on gemini-2.0-flash, 1500 req/day on free tier.
# Supports up to 3 keys for rotation.
#
# Note: This uses the AI Studio free-tier endpoint. For production with
# EU personal data, consider migrating to Vertex AI (which has Google Cloud
# DPA self-executing upon acceptance of Google Cloud Terms).
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# ─── AI Vision (Mistral — EU-based, GDPR-friendly) ─────────────────────
# STRATEGIC: Mistral AI is based in Paris, France (EU). Transfers to them
# are expected to remain within the EEA, subject to Mistral's applicable
# terms — NO SCC NEEDED.
#
# Mistral is tried FIRST in both vision and chat cascades.
# Falls through to Groq (US, SCCs confirmed) if Mistral is rate-limited.
#
# Free signup at https://console.mistral.ai/ (no credit card needed).
# Free tier: ~1 req/s, 500K tokens/min, 1M tokens/hour.
# Models: pixtral-large-latest (best), pixtral-12b-latest (smaller/faster).
# Supports up to 3 keys for rotation.
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=
# Set to 'true' to send usage_options={"enable_training": false} on every
# Mistral API call. Recommended for production. On paid Mistral tier, this
# disables training on prompt content. On free tier, Mistral may ignore
# or reject this parameter (caller handles 400 errors by retrying without).
MISTRAL_DISABLE_TRAINING=true

# ─── Email Service (Resend) — for email verification on signup ────────
# Required for the email verification feature. Without this, new users
# cannot verify their email and will be blocked from using AI features
# (upload, scan, chat).
#
# Free signup at https://resend.com (no credit card needed).
# Free tier: 100 emails/day.
# Get API key at https://resend.com/api-keys
#
# Default sender: onboarding@resend.dev (works immediately for testing).
# For production: verify your own domain at https://resend.com/domains
# and set RESEND_FROM_EMAIL (e.g. noreply@omniparse-ai.com).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── Stripe ────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# Stripe Price IDs for paid plans (create products in Stripe Dashboard)
STRIPE_PRO_PRICE_ID=price_your_pro_price_id_here
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id_here

# ─── App URL ────────────────────────────────────────────────────────────
# Used for Stripe redirects and email links.
# In dev: http://localhost:3000
# In prod: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cron (optional) ────────────────────────────────────────────────────
# Secret for the /api/cron/purge-files endpoint. Generate with:
#   openssl rand -hex 16
# Set the same value in Vercel cron config.
CRON_SECRET=your-cron-secret-here
