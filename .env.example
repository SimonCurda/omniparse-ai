# ─── Database ────────────────────────────────────────────────────────────
# Your Supabase Postgres connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://your-supabase-user:your-password@db.your-project.supabase.co:5432/postgres

# ─── Auth ───────────────────────────────────────────────────────────────
# JWT secret for signing user session tokens. Generate with:
#   openssl rand -hex 32
JWT_SECRET=your-random-32-hex-string-here

# ─── AI (Groq) — optional but recommended ────────────────────────────────
# Get from: https://console.groq.com/keys
# Groq is the secondary provider in both cascades (after Mistral).
# GROQ_API_KEY is now OPTIONAL — leaving it unset enables EU-only mode
# (Mistral only). When unset, the Groq cascade step is skipped.
GROQ_API_KEY=

# ─── AI Fallback (OpenRouter) — DISABLED BY DEFAULT ─────────────────────
# ⚠️ LEGAL COMPLIANCE: OpenRouter is DISABLED by default.
#
# OpenRouter's free-tier models (all model IDs ending in :free) route
# requests to underlying providers (Meta, Nvidia, Google, etc.) whose
# data-handling terms typically PERMIT TRAINING ON PROMPT CONTENT.
# There is no DPA or SCC in place with OpenRouter as of September 2026.
#
# To enable OpenRouter (NOT recommended for production EU personal data):
#   1. Complete a DPA with OpenRouter (https://openrouter.ai/legal)
#   2. Verify SCCs or confirm DPF certification
#   3. Switch to paid-tier models (remove :free suffix) to disable training
#   4. Update Privacy Policy §6 SCC Status table
#   5. Set ENABLE_OPENROUTER=true in Vercel env vars
#
# Free signup at https://openrouter.ai/keys (no credit card needed).
# Supports up to 5 keys for rotation.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=
# Set to 'true' to enable OpenRouter in the cascade. Default: disabled.
ENABLE_OPENROUTER=

# ─── AI Vision Fallback (Google Gemini direct API) — DISABLED BY DEFAULT ─
# ⚠️ LEGAL COMPLIANCE: Google Gemini (AI Studio free-tier endpoint) is
# DISABLED by default. The AI Studio free-tier data-handling terms are
# weaker than Google Cloud Vertex AI (which has a self-executing DPA).
# For EU personal data, the AI Studio free tier is not recommended.
#
# To enable Google Gemini (NOT recommended for production EU personal data):
#   1. Review Google AI Studio terms at https://ai.google.dev/terms
#   2. Verify the data-handling terms are acceptable for the data being processed
#   3. OR migrate to Vertex AI (separate code path, not currently supported)
#   4. Update Privacy Policy §6 SCC Status table
#   5. Set ENABLE_GOOGLE_GEMINI=true in Vercel env vars
#
# Free signup at https://aistudio.google.com/app/apikey (no credit card needed).
# 15 req/min on gemini-2.0-flash, 1500 req/day on free tier.
# Supports up to 3 keys for rotation.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Set to 'true' to enable Google Gemini in the cascade. Default: disabled.
ENABLE_GOOGLE_GEMINI=

# ─── AI Vision (Mistral — EU-based, GDPR-friendly) ─────────────────────
# STRATEGIC: Mistral AI is based in Paris, France (EU). Transfers to them
# are expected to remain within the EEA, subject to Mistral's applicable
# terms — NO SCC NEEDED.
#
# Mistral is tried FIRST in both vision and chat cascades.
# Falls through to Groq (US, SCCs confirmed) if Mistral is rate-limited.
#
# Free signup at https://console.mistral.ai/ (no credit card needed).
# Free tier: ~1 req/s, 500K tokens/min, 1M tokens/hour.
# Models: pixtral-large-latest (best), pixtral-12b-latest (smaller/faster).
# Supports up to 3 keys for rotation.
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=
# Set to 'true' to send usage_options={"enable_training": false} on every
# Mistral API call. Recommended for production. On paid Mistral tier, this
# disables training on prompt content. On free tier, Mistral may ignore
# or reject this parameter (caller handles 400 errors by retrying without).
MISTRAL_DISABLE_TRAINING=true

# ─── Email Service (Resend) — for email verification on signup ────────
# Required for the email verification feature. Without this, new users
# cannot verify their email and will be blocked from using AI features
# (upload, scan, chat).
#
# ALSO REQUIRED FOR STRIPE DUNNING: when an invoice.payment_failed webhook
# fires (a customer's card is declined), the webhook sends a dunning email
# via this Resend config — once per failed invoice, deduped via the
# PaymentRecord ledger. If RESEND_API_KEY is unset, the dunning step is
# skipped silently (logged) — the webhook still returns 200 to Stripe.
#
# Free signup at https://resend.com (no credit card needed).
# Free tier: 100 emails/day.
# Get API key at https://resend.com/api-keys
#
# Default sender: onboarding@resend.dev (works immediately for testing).
# For production: verify your own domain at https://resend.com/domains
# and set RESEND_FROM_EMAIL (e.g. noreply@omniparse-ai.com).
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── Stripe ────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
#
# EU VAT / OSS OBLIGATION (Czech-established seller): once your EU
# cross-border B2C digital revenue exceeds €10,000/yr, you MUST register
# for the OSS (One Stop Shop) scheme with the Czech finanční úřad and file
# quarterly returns (20 Apr / 20 Jul / 20 Oct / 20 Jan). Stripe Tax
# CALCULATES the VAT; the actual filing is YOUR obligation. The
# PaymentRecord table (populated by the webhook) + /api/export/oss CSV are
# the inputs for that filing. See docs/STRIPE-SETUP.md §8 go-live checklist.
#
# STRIPE PRICE IDS — 8 prices total (4 plans × 2 intervals)
# ────────────────────────────────────────────────────────────────────────
# In the Stripe Dashboard (https://dashboard.stripe.com/products) create:
#
#   4 PRODUCTS:
#     1. Pro          ($49/mo,  $39/mo when paid annually)
#     2. Plus         ($99/mo,  $79/mo when paid annually)
#     3. Business     ($199/mo, $159/mo when paid annually)
#     4. Enterprise   ($499/mo, $399/mo when paid annually)
#
#   For each product, create TWO recurring prices:
#     a) Monthly — recurring.interval=month, recurring.interval_count=1
#     b) Annual  — recurring.interval=year,  recurring.interval_count=1
#
#   Currency: USD (Stripe Tax still calculates EU VAT on top regardless of
#   charge currency; the customer sees the localised amount at checkout).
#
#   For each price, copy the price_xxx ID into the env vars below.
#
#   STRIPE TAX — required for EU VAT compliance:
#     1. Enable Stripe Tax at https://dashboard.stripe.com/tax
#     2. On each Stripe Product, set the tax code to
#        "Software / digital services" (tax_code: txcd_1010201) — required
#        for Stripe Tax to calculate EU VAT correctly.
#     3. Stripe Tax has a free tier of 1,000 calculations/month.
#
#   CUSTOMER PORTAL — required for self-serve cancellation + plan changes:
#     1. Configure at https://dashboard.stripe.com/settings/billing/portal
#     2. Recommended settings:
#          - Customer information: email + address editable
#          - Subscription cancellation: allow immediate + at period end
#          - Subscription update: allow switching between monthly/annual
#            with prorations enabled
#     3. (Optional) If you create a custom Portal config, set its ID below.
STRIPE_PRICE_ID_MONTHLY_PRO=
STRIPE_PRICE_ID_ANNUAL_PRO=
STRIPE_PRICE_ID_MONTHLY_PLUS=
STRIPE_PRICE_ID_ANNUAL_PLUS=
STRIPE_PRICE_ID_MONTHLY_BUSINESS=
STRIPE_PRICE_ID_ANNUAL_BUSINESS=
STRIPE_PRICE_ID_MONTHLY_ENTERPRISE=
STRIPE_PRICE_ID_ANNUAL_ENTERPRISE=
# Optional: pin Customer Portal to a specific configuration (bpc_xxx).
# If empty, Stripe uses the default portal configuration.
STRIPE_PORTAL_CONFIG_ID=
#
# LEGACY price IDs (still read by older code paths for backward compat).
# These are the old single-interval IDs — kept here only so existing
# deployments don't break. New deployments should use the 8 IDs above.
STRIPE_PRO_PRICE_ID=
STRIPE_PLUS_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ─── App URL ────────────────────────────────────────────────────────────
# Used for Stripe redirects and email links.
# In dev: http://localhost:3000
# In prod: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Admin Email Alerts ────────────────────────────────────────────────
# Used by the model health monitor to send alerts when an AI model goes
# down or gets decommissioned. Set to the email address where you want
# to receive alerts.
ADMIN_EMAIL=damr58h@gmail.com

# ─── Cron (optional) ────────────────────────────────────────────────────
# Secret for the /api/cron/purge-files endpoint. Generate with:
#   openssl rand -hex 16
# Set the same value in Vercel cron config.
CRON_SECRET=your-cron-secret-here

# ─── GitHub Backup (optional) ───────────────────────────────────────────
# When configured, the admin "Push to GitHub" button (and any future
# cron-triggered backup) will push the JSON dump to this repo via the
# GitHub Contents API. Files land at:
#   backups/omniparse-backup-<timestamp>.json   (new file every run)
#   backups/latest.json                         (overwritten every run)
#
# Create a fine-grained PAT at https://github.com/settings/personal-access-tokens
# with `Contents: Read and write` on the target repository (classic PATs with
# the `repo` scope also work).
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_OWNER=
GITHUB_BACKUP_REPO=
