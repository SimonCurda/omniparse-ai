# ─── Database ────────────────────────────────────────────────────────────
# Your Supabase Postgres connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://your-supabase-user:your-password@db.your-project.supabase.co:5432/postgres

# ─── Auth ───────────────────────────────────────────────────────────────
# JWT secret for signing user session tokens. Generate with:
#   openssl rand -hex 32
JWT_SECRET=your-random-32-hex-string-here

# ─── AI (Groq) ──────────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── AI Fallback (OpenRouter) ───────────────────────────────────────────
# Optional but recommended — used as fallback when Groq is rate-limited.
# Free signup at https://openrouter.ai/keys (no credit card needed).
# Without this, the chat will only use Groq (and fail when Groq quota is exhausted).
# Supports up to 5 keys for rotation — add more keys to multiply free-tier quota.
OPENROUTER_API_KEY=sk-or-v1_your_openrouter_api_key_here
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=

# ─── AI Vision Fallback (Google Gemini direct API) ─────────────────────
# Optional but recommended — Google's Gemini API has its OWN free tier
# (separate from OpenRouter/Groq), so it multiplies your vision capacity.
# Free signup at https://aistudio.google.com/app/apikey (no credit card needed).
# 15 req/min on gemini-2.0-flash, 1500 req/day on free tier.
# Supports up to 3 keys for rotation.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# ─── AI Vision (Mistral — EU-based, GDPR-friendly) ─────────────────────
# STRATEGIC: Mistral AI is based in Paris, France (EU). Transfers to them
# stay within the EU — NO SCC NEEDED, NO Schrems II issue.
#
# This means: even before SCCs with US providers (OpenRouter, Groq, Google)
# are signed, EU users CAN legally use OmniParse via Mistral.
#
# Mistral is tried FIRST in the vision cascade — before OpenRouter.
# Falls through to US providers if Mistral is rate-limited or unavailable.
#
# Free signup at https://console.mistral.ai/ (no credit card needed).
# Free tier: ~1 req/s, 500K tokens/min, 1M tokens/hour.
# Models: pixtral-large-latest (best), pixtral-12b-latest (smaller/faster).
# Supports up to 3 keys for rotation.
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=

# ─── Stripe ────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# Stripe Price IDs for paid plans (create products in Stripe Dashboard)
STRIPE_PRO_PRICE_ID=price_your_pro_price_id_here
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id_here

# ─── App URL ────────────────────────────────────────────────────────────
# Used for Stripe redirects and email links.
# In dev: http://localhost:3000
# In prod: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cron (optional) ────────────────────────────────────────────────────
# Secret for the /api/cron/purge-files endpoint. Generate with:
#   openssl rand -hex 16
# Set the same value in Vercel cron config.
CRON_SECRET=your-cron-secret-here
